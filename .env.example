# n8n Webhook URL
# Replace with your actual n8n Cloud webhook URL
# Example: https://yourinstance.app.n8n.cloud/webhook/your-webhook-id
N8N_WEBHOOK_URL=https://yourinstance.app.n8n.cloud/webhook/your-webhook-id

# MongoDB Connection String (Optional - for activity logging)
# Get free MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/chatbot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chatbot

# Admin credentials for the admin portal login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Last.fm integration (T-Display P4 music screen — no developer app needed)
# 1. Create free account at last.fm and get API key: https://www.last.fm/api/account/create
# 2. Install the Last.fm app on your phone and connect Spotify/Apple Music to scrobble
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_USERNAME=your_lastfm_username

# Optional: webhook to forward play/pause/next/prev button presses from T-Display
# e.g. a Home Assistant webhook URL, or any HTTP endpoint that controls your player
MUSIC_CONTROL_WEBHOOK=

# Weather Radio (T-Display P4 music screen) — uses Open-Meteo, no API key needed
# Defaults to Vancouver, WA 98683
WEATHER_LAT=45.63
WEATHER_LON=-122.49

# NOAA Weather Radio audio stream — requires ffmpeg installed on this machine
# Set to any internet stream URL for your local NOAA weather radio station.
# Find streams at: broadcastify.com or radioreference.com → search your state + "WX weather"
# Example (replace with your local WX station):
WEATHER_RADIO_URL=
